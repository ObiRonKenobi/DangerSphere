# NASA FIRMS MAP_KEY (optional — wildfires skipped without it)
# Get one free at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=

# Cache path inside the container (host bind-mounts ./data)
CACHE_PATH=/app/data/live_disasters.json.gz

# Scrape interval in seconds (default 15 minutes)
SCRAPE_INTERVAL_SECONDS=900

# FIRMS: max hotspot points kept after filtering
FIRMS_MAX_POINTS=5000
